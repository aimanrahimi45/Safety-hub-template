---
import AppLayout from '../../layouts/AppLayout.astro';

const setupWarning = !import.meta.env.PUBLIC_SUPABASE_URL || !import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<AppLayout title="Dashboard - AmerisPro">

  <main class="dashboard-page">
    <div class="container dash-viewport-container">
      <div id="dash-setup-warning" class="dash-warning" hidden={!setupWarning}>
        <strong>Setup required.</strong>
        <span>
          Supabase environment variables are not configured. Copy
          <code>.env.example</code> to <code>.env</code>, fill in your
          Supabase credentials, then restart the dev server.
        </span>
      </div>

      <!-- SVG Content Loader Skeleton (Inspired by react-content-loader, prevents layout blips) -->
      <div id="dash-skeleton-loader" class="dash-skeleton-container">
        <div class="dash-skeleton-hero">
          <div class="skeleton-rect line-title"></div>
          <div class="skeleton-rect line-sub"></div>
        </div>
        <div class="dash-skeleton-kpi-grid">
          <div class="skeleton-rect kpi-pill"></div>
          <div class="skeleton-rect kpi-pill"></div>
          <div class="skeleton-rect kpi-pill"></div>
          <div class="skeleton-rect kpi-pill"></div>
          <div class="skeleton-rect kpi-pill"></div>
          <div class="skeleton-rect kpi-pill"></div>
        </div>
        <div class="dash-skeleton-main-grid">
          <div class="dash-skeleton-left">
            <div class="skeleton-card chart-skeleton-1">
              <div class="skeleton-chart-bars">
                <div class="skeleton-bar" style="height: 45%;"></div>
                <div class="skeleton-bar" style="height: 70%;"></div>
                <div class="skeleton-bar" style="height: 30%;"></div>
                <div class="skeleton-bar" style="height: 85%;"></div>
                <div class="skeleton-bar" style="height: 55%;"></div>
                <div class="skeleton-bar" style="height: 75%;"></div>
              </div>
            </div>
            <div class="skeleton-card chart-skeleton-2">
              <div class="skeleton-donut-ring"></div>
              <div class="skeleton-stat-pills">
                <div class="skeleton-rect stat-pill-skel"></div>
                <div class="skeleton-rect stat-pill-skel"></div>
              </div>
            </div>
          </div>
          <div class="dash-skeleton-right">
            <div class="skeleton-card activity-skel">
              <div class="skeleton-rect act-row"></div>
              <div class="skeleton-rect act-row"></div>
              <div class="skeleton-rect act-row"></div>
              <div class="skeleton-rect act-row"></div>
              <div class="skeleton-rect act-row"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Real Dashboard Hero -->
      <section id="dash-hero" class="dash-hero" hidden>
        <div class="dash-hero-text">
          <h1>Welcome, <span id="dash-tenant-name">…</span></h1>
          <p class="dash-company" id="dash-company-name">…</p>
        </div>
        <div class="dash-meta">
          <span id="dash-plan-badge" class="plan-badge plan-free">Free</span>
          <span class="dash-expiry" id="dash-expiry">No expiry set</span>
        </div>
      </section>

      <section id="dash-error" class="dash-error" hidden>
        Failed to load workspace data. Please refresh the page.
      </section>

      <div id="dash-mobile-tabs" class="dash-mobile-tabs">
        <button type="button" id="dash-tab-overview" class="dash-tab-btn active">📊 Overview</button>
        <button type="button" id="dash-tab-activity" class="dash-tab-btn">⚡ Activity Feed</button>
      </div>

      <!-- Top KPI Metric Strip (6 Compact Cards) -->
      <section id="dash-metrics" class="dash-metrics-section" hidden>
        <div class="metric-grid">
          <a href="/app/first-aid" class="metric-tile" id="metric-first-aid">
            <div class="metric-tile-head">
              <span class="metric-tile-icon" aria-hidden="true">⛑️</span>
              <span class="metric-tile-label">First Aid</span>
            </div>
            <div class="metric-tile-body">
              <div class="metric-tile-value" data-role="value">—</div>
              <div class="metric-tile-sub" data-role="sub">…</div>
            </div>
          </a>
          <a href="/app/ppe" class="metric-tile" id="metric-ppe">
            <div class="metric-tile-head">
              <span class="metric-tile-icon" aria-hidden="true">🦺</span>
              <span class="metric-tile-label">PPE Issues</span>
            </div>
            <div class="metric-tile-body">
              <div class="metric-tile-value" data-role="value">—</div>
              <div class="metric-tile-sub" data-role="sub">…</div>
            </div>
          </a>
          <a href="/app/contractors" class="metric-tile" id="metric-contractors">
            <div class="metric-tile-head">
              <span class="metric-tile-icon" aria-hidden="true">👷</span>
              <span class="metric-tile-label">Contractors</span>
            </div>
            <div class="metric-tile-body">
              <div class="metric-tile-value" data-role="value">—</div>
              <div class="metric-tile-sub" data-role="sub">…</div>
            </div>
          </a>
          <a href="/app/incidents" class="metric-tile" id="metric-incidents">
            <div class="metric-tile-head">
              <span class="metric-tile-icon" aria-hidden="true">🚨</span>
              <span class="metric-tile-label">Incidents</span>
            </div>
            <div class="metric-tile-body">
              <div class="metric-tile-value" data-role="value">—</div>
              <div class="metric-tile-sub" data-role="sub">…</div>
            </div>
          </a>
          <a href="/app/staff" class="metric-tile" id="metric-staff">
            <div class="metric-tile-head">
              <span class="metric-tile-icon" aria-hidden="true">🧑‍💼</span>
              <span class="metric-tile-label">Staff Active</span>
            </div>
            <div class="metric-tile-body">
              <div class="metric-tile-value" data-role="value">—</div>
              <div class="metric-tile-sub" data-role="sub">…</div>
            </div>
          </a>
          <a href="/app/inspections" class="metric-tile" id="metric-inspections">
            <div class="metric-tile-head">
              <span class="metric-tile-icon" aria-hidden="true">📋</span>
              <span class="metric-tile-label">Inspections</span>
            </div>
            <div class="metric-tile-body">
              <div class="metric-tile-value" data-role="value">—</div>
              <div class="metric-tile-sub" data-role="sub">…</div>
            </div>
          </a>
        </div>
      </section>

      <!-- Main Single Viewport Content Grid -->
      <div class="dash-grid-layout">
        <!-- Left Column: Visual Charts Section (Desktop Only) -->
        <section id="dash-charts-section" class="dash-charts-section" hidden>
          <!-- Chart 1: Safety Performance & Incident Monthly Trend -->
          <div class="dash-chart-card">
            <div class="dash-chart-header">
              <div>
                <h3>📈 OSH Incident & Safety Monthly Trend</h3>
                <p class="dash-chart-sub">Monthly breakdown of recorded incidents and first aid logs</p>
              </div>
              <div class="dash-chart-legend">
                <span class="legend-item"><span class="legend-dot dot-incident"></span>Incidents</span>
                <span class="legend-item"><span class="legend-dot dot-firstaid"></span>First Aid</span>
              </div>
            </div>
            <div class="dash-canvas-wrapper">
              <canvas id="canvas-incident-trend"></canvas>
            </div>
          </div>

          <!-- Chart 2: Compliance Rate Donut & Progress Gauge -->
          <div class="dash-chart-card">
            <div class="dash-chart-header">
              <div>
                <h3>🍩 OSH Inspection & Compliance Status</h3>
                <p class="dash-chart-sub">Site audit completion & PPE fulfillment readiness rate</p>
              </div>
            </div>
            <div class="dash-chart-split">
              <div class="dash-canvas-donut-wrapper">
                <canvas id="canvas-compliance-donut"></canvas>
              </div>
              <div class="dash-compliance-stats">
                <div class="stat-pill stat-completed">
                  <span class="stat-num" id="stat-inspections-pct">0%</span>
                  <span class="stat-lbl">Inspection Completion</span>
                </div>
                <div class="stat-pill stat-pending">
                  <span class="stat-num" id="stat-ppe-pct">0%</span>
                  <span class="stat-lbl">PPE Fulfillment Rate</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Right Column: Action Alerts & Height-Guarded Activity Feed -->
        <div class="dash-sidebar-column">
          <!-- Action Alerts Banner Widget -->
          <div id="dash-alerts-card" class="dash-alerts-card" hidden>
            <div class="dash-alerts-title">⚡ Attention Required</div>
            <div id="dash-alerts-list" class="dash-alerts-list"></div>
          </div>

          <!-- Recent Activity Feed (Height Guarded + Internal Scroll) -->
          <section id="dash-activity" class="activity-feed" hidden>
            <div class="activity-feed-header">
              <h2>⚡ Recent Activity</h2>
              <span class="activity-count-tag" id="activity-count-tag">Live</span>
            </div>
            <div id="dash-activity-scroll-area" class="activity-scroll-area">
              <div id="dash-activity-list"></div>
              <div id="dash-activity-empty" class="activity-empty" hidden>
                No recent activity yet. Start by logging a First Aid inspection or reporting an incident.
              </div>
            </div>
            <div class="activity-feed-footer">
              <a href="/app/inspections" class="activity-view-all">View All Activity Log →</a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</AppLayout>

<script>
  import { getSupabase, isSupabaseConfigured } from '../../lib/supabase';
  import type { Tenant } from '../../lib/types';

  // -------------------------------------------------------------------
  // Refs
  // -------------------------------------------------------------------
  const heroEl = document.getElementById('dash-hero') as HTMLElement;
  const metricsEl = document.getElementById('dash-metrics') as HTMLElement;
  const chartsEl = document.getElementById('dash-charts-section') as HTMLElement;
  const alertsCardEl = document.getElementById('dash-alerts-card') as HTMLElement;
  const alertsListEl = document.getElementById('dash-alerts-list') as HTMLElement;
  const activityEl = document.getElementById('dash-activity') as HTMLElement;
  const activityListEl = document.getElementById('dash-activity-list') as HTMLElement;
  const activityEmptyEl = document.getElementById('dash-activity-empty') as HTMLElement;
  const errorEl = document.getElementById('dash-error') as HTMLElement;
  const tenantNameEl = document.getElementById('dash-tenant-name') as HTMLElement;
  const companyNameEl = document.getElementById('dash-company-name') as HTMLElement;
  const planBadgeEl = document.getElementById('dash-plan-badge') as HTMLElement;
  const expiryEl = document.getElementById('dash-expiry') as HTMLElement;
  const statInspectionsPct = document.getElementById('stat-inspections-pct') as HTMLElement;
  const statPpePct = document.getElementById('stat-ppe-pct') as HTMLElement;
  const skeletonLoaderEl = document.getElementById('dash-skeleton-loader') as HTMLElement;

  function showError(): void {
    if (skeletonLoaderEl) skeletonLoaderEl.style.display = 'none';
    if (errorEl) errorEl.hidden = false;
  }

  function escapeHtml(s: string | null | undefined): string {
    return (s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  }

  function formatDate(iso: string | null | undefined): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    return d.toLocaleDateString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  }

  function relativeTime(iso: string | null | undefined): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    const diffSec = Math.floor((Date.now() - d.getTime()) / 1000);
    if (diffSec < 60) return 'just now';
    if (diffSec < 3600) {
      const m = Math.floor(diffSec / 60);
      return `${m} min ago`;
    }
    if (diffSec < 86400) {
      const h = Math.floor(diffSec / 3600);
      return `${h} hour${h === 1 ? '' : 's'} ago`;
    }
    if (diffSec < 604800) {
      const dys = Math.floor(diffSec / 86400);
      return `${dys} day${dys === 1 ? '' : 's'} ago`;
    }
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return `${String(d.getDate()).padStart(2, '0')} ${months[d.getMonth()]} ${d.getFullYear()}`;
  }

  type Metric = {
    id: string;
    value: number | null;
    sub: string;
  };

  function renderMetric(m: Metric): void {
    const tile = document.getElementById(`metric-${m.id}`);
    if (!tile) return;
    const valueEl = tile.querySelector('[data-role="value"]') as HTMLElement | null;
    const subEl = tile.querySelector('[data-role="sub"]') as HTMLElement | null;
    if (valueEl) valueEl.textContent = m.value == null ? '—' : String(m.value);
    if (subEl) subEl.textContent = m.sub;
  }

  type ActivityKind = 'first_aid' | 'ppe' | 'contractor' | 'incident' | 'staff' | 'inspection';

  type ActivityItem = {
    id: string;
    kind: ActivityKind;
    icon: string;
    title: string;
    sub: string;
    createdAt: string;
    href: string;
  };

  function getDateGroupHeader(iso: string | null | undefined): string {
    if (!iso) return 'EARLIER';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'EARLIER';
    const now = new Date();
    if (d.toDateString() === now.toDateString()) return 'TODAY';
    
    const yesterday = new Date(now);
    yesterday.setDate(now.getDate() - 1);
    if (d.toDateString() === yesterday.toDateString()) return 'YESTERDAY';

    return 'EARLIER THIS WEEK';
  }

  function renderActivity(items: ActivityItem[]): void {
    if (!activityListEl || !activityEmptyEl) return;
    activityListEl.innerHTML = '';
    if (items.length === 0) {
      activityEmptyEl.hidden = false;
      return;
    }
    activityEmptyEl.hidden = true;

    let currentGroup = '';

    for (const a of items) {
      const group = getDateGroupHeader(a.createdAt);
      if (group !== currentGroup) {
        currentGroup = group;
        const groupEl = document.createElement('div');
        groupEl.className = 'activity-group-label';
        groupEl.textContent = currentGroup;
        activityListEl.appendChild(groupEl);
      }

      const row = document.createElement('a');
      row.className = `activity-item activity-kind-${a.kind}`;
      row.href = a.href;
      row.innerHTML = `
        <div class="activity-item-icon act-icon-${a.kind}" aria-hidden="true">${escapeHtml(a.icon)}</div>
        <div class="activity-item-body">
          <div class="activity-item-title">${escapeHtml(a.title)}</div>
          <div class="activity-item-sub">${escapeHtml(a.sub)}</div>
        </div>
        <div class="activity-item-right">
          <span class="activity-item-time">${escapeHtml(relativeTime(a.createdAt))}</span>
          <span class="activity-item-arrow" aria-hidden="true">→</span>
        </div>
      `;
      activityListEl.appendChild(row);
    }
  }

  // Easing function for smooth 60fps animation
  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  let trendAnimFrame: number | null = null;
  let donutAnimFrame: number | null = null;

  // Canvas 1: Monthly Incident & Safety Trend Bar Chart (Animated)
  function drawIncidentTrendChart(months: string[], incidentCounts: number[], firstAidCounts: number[]): void {
    if (trendAnimFrame) cancelAnimationFrame(trendAnimFrame);

    const startTime = performance.now();
    const duration = 750; // ms

    function renderFrame(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);
      const ease = easeOutCubic(progress);

      const currentInc = incidentCounts.map((v) => v * ease);
      const currentFa = firstAidCounts.map((v) => v * ease);

      drawIncidentTrendCanvasFrame(months, currentInc, currentFa);

      if (progress < 1) {
        trendAnimFrame = requestAnimationFrame(renderFrame);
      }
    }

    trendAnimFrame = requestAnimationFrame(renderFrame);
  }

  function drawIncidentTrendCanvasFrame(months: string[], incidentCounts: number[], firstAidCounts: number[]): void {
    const canvas = document.getElementById('canvas-incident-trend') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return;

    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const width = rect.width;
    const height = rect.height;
    ctx.clearRect(0, 0, width, height);

    const padding = { top: 20, right: 20, bottom: 35, left: 35 };
    const chartW = width - padding.left - padding.right;
    const chartH = height - padding.top - padding.bottom;

    const maxVal = Math.max(5, ...incidentCounts, ...firstAidCounts);
    const barGroupWidth = chartW / months.length;
    const barWidth = Math.min(18, barGroupWidth * 0.35);

    // Draw Grid Lines
    ctx.strokeStyle = '#E2E8F0';
    ctx.lineWidth = 1;
    ctx.fillStyle = '#64748B';
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'right';

    for (let i = 0; i <= 4; i++) {
      const val = Math.round((maxVal / 4) * i);
      const y = padding.top + chartH - (chartH / 4) * i;
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(width - padding.right, y);
      ctx.stroke();
      ctx.fillText(String(val), padding.left - 6, y + 3);
    }

    // Draw Bars
    months.forEach((m, idx) => {
      const xCenter = padding.left + barGroupWidth * idx + barGroupWidth / 2;
      const xInc = xCenter - barWidth - 3;
      const xFa = xCenter + 3;

      // Incidents Bar (Red)
      const incH = (incidentCounts[idx] / maxVal) * chartH;
      const incY = padding.top + chartH - incH;
      ctx.fillStyle = '#FF6B6B';
      ctx.strokeStyle = '#2B2D42';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect(xInc, incY, barWidth, Math.max(2, incH), [4, 4, 0, 0]);
      ctx.fill();
      ctx.stroke();

      // First Aid Bar (Yellow)
      const faH = (firstAidCounts[idx] / maxVal) * chartH;
      const faY = padding.top + chartH - faH;
      ctx.fillStyle = '#FFD166';
      ctx.beginPath();
      ctx.roundRect(xFa, faY, barWidth, Math.max(2, faH), [4, 4, 0, 0]);
      ctx.fill();
      ctx.stroke();

      // Month Label
      ctx.fillStyle = '#2B2D42';
      ctx.font = 'bold 11px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(m, xCenter, height - 10);
    });
  }

  // Canvas 2: Compliance Donut & Progress Gauge (Animated & Perfect Circle Fix)
  function drawComplianceDonut(targetInsPct: number, targetPpePct: number): void {
    if (donutAnimFrame) cancelAnimationFrame(donutAnimFrame);

    const startTime = performance.now();
    const duration = 850; // ms

    function renderFrame(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);
      const ease = easeOutCubic(progress);

      const currentIns = targetInsPct * ease;
      const currentPpe = targetPpePct * ease;

      drawComplianceDonutCanvasFrame(currentIns, currentPpe);

      if (progress < 1) {
        donutAnimFrame = requestAnimationFrame(renderFrame);
      }
    }

    donutAnimFrame = requestAnimationFrame(renderFrame);
  }

  function drawComplianceDonutCanvasFrame(inspectionPct: number, ppePct: number): void {
    const canvas = document.getElementById('canvas-compliance-donut') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return;

    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const width = rect.width;
    const height = rect.height;
    ctx.clearRect(0, 0, width, height);

    const centerX = width / 2;
    const centerY = height / 2;
    const side = Math.min(width, height);
    const outerRadius = Math.max(10, side / 2 - 12);
    const innerRadius = Math.max(10, outerRadius - 16);

    // Background Outer Ring
    ctx.strokeStyle = '#E2E8F0';
    ctx.lineWidth = 12;
    ctx.beginPath();
    ctx.arc(centerX, centerY, outerRadius, 0, 2 * Math.PI);
    ctx.stroke();

    // Inspection Arc (Emerald Green)
    const insAngle = (Math.min(100, Math.max(0, inspectionPct)) / 100) * 2 * Math.PI;
    if (insAngle > 0) {
      ctx.strokeStyle = '#06D6A0';
      ctx.lineWidth = 12;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.arc(centerX, centerY, outerRadius, -Math.PI / 2, -Math.PI / 2 + insAngle);
      ctx.stroke();
    }

    // Background Inner Ring
    ctx.strokeStyle = '#E2E8F0';
    ctx.lineWidth = 9;
    ctx.beginPath();
    ctx.arc(centerX, centerY, innerRadius - 6, 0, 2 * Math.PI);
    ctx.stroke();

    // PPE Arc (Blue)
    const ppeAngle = (Math.min(100, Math.max(0, ppePct)) / 100) * 2 * Math.PI;
    if (ppeAngle > 0) {
      ctx.strokeStyle = '#4EA8DE';
      ctx.lineWidth = 9;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.arc(centerX, centerY, innerRadius - 6, -Math.PI / 2, -Math.PI / 2 + ppeAngle);
      ctx.stroke();
    }

    // Center Text
    ctx.fillStyle = '#2B2D42';
    ctx.font = '900 15px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${Math.round(inspectionPct)}%`, centerX, centerY - 2);
    ctx.font = 'bold 9px sans-serif';
    ctx.fillStyle = '#64748B';
    ctx.fillText('READINESS', centerX, centerY + 13);
  }

  // Mobile Tab Switcher Handler
  const tabOverview = document.getElementById('dash-tab-overview') as HTMLButtonElement | null;
  const tabActivity = document.getElementById('dash-tab-activity') as HTMLButtonElement | null;

  function applyMobileTabState(): void {
    if (window.innerWidth <= 768) {
      const isActivityActive = tabActivity?.classList.contains('active');
      if (isActivityActive) {
        if (metricsEl) metricsEl.style.display = 'none';
        if (activityEl) activityEl.style.display = 'block';
      } else {
        if (metricsEl) metricsEl.style.display = 'block';
        if (activityEl) activityEl.style.display = 'none';
      }
    } else {
      if (metricsEl) metricsEl.style.display = '';
      if (activityEl) activityEl.style.display = '';
    }
  }

  if (tabOverview && tabActivity && metricsEl && activityEl) {
    tabOverview.addEventListener('click', () => {
      tabOverview.classList.add('active');
      tabActivity.classList.remove('active');
      applyMobileTabState();
    });

    tabActivity.addEventListener('click', () => {
      tabActivity.classList.add('active');
      tabOverview.classList.remove('active');
      applyMobileTabState();
    });

    window.addEventListener('resize', applyMobileTabState);
  }

  // Boot
  if (!isSupabaseConfigured()) {
    showError();
  } else {
    const supabase = getSupabase();

    (async () => {
      let user = (await supabase.auth.getUser()).data.user;
      if (!user) {
        user = (await supabase.auth.getSession()).data.session?.user ?? null;
      }
      if (!user) {
        window.location.replace('/login');
        return;
      }

      const { data: tenant, error: tenantErr } = await supabase
        .from('tenants')
        .select('*')
        .eq('owner_user_id', user.id)
        .single<Tenant>();

      if (tenantErr || !tenant) {
        window.location.replace('/app/onboarding');
        return;
      }

      if (tenantNameEl) tenantNameEl.textContent = tenant.name;
      if (companyNameEl) companyNameEl.textContent = tenant.company_name ?? '';

      if (tenant.subscription_plan === 'premium') {
        if (planBadgeEl) {
          planBadgeEl.textContent = 'Premium';
          planBadgeEl.className = 'plan-badge plan-premium';
        }
      } else if (tenant.subscription_plan === 'trial') {
        if (planBadgeEl) {
          planBadgeEl.textContent = 'Free Trial';
          planBadgeEl.className = 'plan-badge plan-trial';
        }
      } else {
        if (planBadgeEl) {
          planBadgeEl.textContent = 'Free';
          planBadgeEl.className = 'plan-badge plan-free';
        }
      }

      if (tenant.subscription_expires_at) {
        const expiresDate = new Date(tenant.subscription_expires_at);
        const daysLeft = Math.max(0, Math.ceil((expiresDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)));
        if (expiryEl) {
          expiryEl.textContent = tenant.subscription_plan === 'trial' 
            ? `⏳ ${daysLeft} days left in Trial` 
            : 'Expires: ' + formatDate(tenant.subscription_expires_at);
        }
      } else {
        if (expiryEl) expiryEl.textContent = 'No expiry set';
      }

      // Parallel Data Fetching
      const now = new Date();
      const year = now.getFullYear();
      const month = now.getMonth();
      const monthStart = `${year}-${String(month + 1).padStart(2, '0')}-01`;
      const yearStart = `${year}-01-01T00:00:00.000Z`;
      const nextYearStart = `${year + 1}-01-01T00:00:00.000Z`;
      const qStartMonth = Math.floor(month / 3) * 3;
      const quarterStart = new Date(year, qStartMonth, 1);
      const quarterStartIso = quarterStart.toISOString().slice(0, 10);

      type CountRes = { count: number | null; error: unknown };
      type RowsRes<T> = { data: T[] | null; error: unknown };

      const safe = async <T,>(p: PromiseLike<T>): Promise<T | null> => {
        try { return await p; } catch { return null; }
      };

      const [
        faMonthRes,
        ppeApprovedRes,
        ppePendingRes,
        ctInductedRes,
        ctPendingRes,
        incYearRes,
        incAwaitingRes,
        staffActiveRes,
        staffInactiveRes,
        insQuarterRes,
        insOverdueRes,
        faRecentRes,
        ppeRecentRes,
        ctRecentRes,
        incRecentRes,
        staffRecentRes,
        insRecentRes,
      ] = await Promise.all([
        safe(supabase.from('first_aid_logs').select('*', { count: 'exact', head: true }).gte('incident_date', monthStart)),
        safe(supabase.from('ppe_requests').select('*', { count: 'exact', head: true }).eq('status', 'approved_dispatched')),
        safe(supabase.from('ppe_requests').select('*', { count: 'exact', head: true }).eq('status', 'pending_approval')),
        safe(supabase.from('contractors').select('*', { count: 'exact', head: true }).eq('status', 'inducted')),
        safe(supabase.from('contractors').select('*', { count: 'exact', head: true }).eq('status', 'pending_induction')),
        safe(supabase.from('incidents').select('*', { count: 'exact', head: true }).gte('incident_date', yearStart).lt('incident_date', nextYearStart)),
        safe(supabase.from('incidents').select('*', { count: 'exact', head: true }).gte('incident_date', yearStart).lt('incident_date', nextYearStart).eq('investigation_submitted', false)),
        safe(supabase.from('staff').select('*', { count: 'exact', head: true }).eq('is_active', true)),
        safe(supabase.from('staff').select('*', { count: 'exact', head: true }).eq('is_active', false)),
        safe(supabase.from('inspections').select('*', { count: 'exact', head: true }).not('completed_date', 'is', null).gte('completed_date', quarterStartIso)),
        safe(supabase.from('inspections').select('*', { count: 'exact', head: true }).eq('status', 'overdue')),
        safe(supabase.from('first_aid_logs').select('id, created_at, injured_person_name, injury_type').order('created_at', { ascending: false }).limit(5)),
        safe(supabase.from('ppe_requests').select('id, created_at, request_code, ppe_type, staff_name').order('created_at', { ascending: false }).limit(5)),
        safe(supabase.from('contractors').select('id, created_at, company_name').order('created_at', { ascending: false }).limit(5)),
        safe(supabase.from('incidents').select('id, created_at, incident_code, victim_name, severity_type').order('created_at', { ascending: false }).limit(5)),
        safe(supabase.from('staff').select('id, created_at, full_name, employee_id').order('created_at', { ascending: false }).limit(5)),
        safe(supabase.from('inspections').select('id, created_at, audit_code, location').order('created_at', { ascending: false }).limit(5)),
      ]);

      const monthName = now.toLocaleDateString(undefined, { month: 'long' });
      const renderCount = (r: unknown): number | null => {
        const res = r as CountRes | null;
        if (!res || res.error) return null;
        return res.count ?? 0;
      };
      const renderRows = <T,>(r: unknown): T[] => {
        const res = r as RowsRes<T> | null;
        if (!res || res.error) return [];
        return res.data ?? [];
      };

      const faVal = renderCount(faMonthRes);
      const ppeAppVal = renderCount(ppeApprovedRes);
      const ppePendVal = renderCount(ppePendingRes) ?? 0;
      const ctIndVal = renderCount(ctInductedRes);
      const ctPendVal = renderCount(ctPendingRes);
      const incVal = renderCount(incYearRes);
      const incAwaitVal = renderCount(incAwaitingRes) ?? 0;
      const staffVal = renderCount(staffActiveRes);
      const staffInactVal = renderCount(staffInactiveRes);
      const insVal = renderCount(insQuarterRes) ?? 0;
      const insOverVal = renderCount(insOverdueRes) ?? 0;

      renderMetric({ id: 'first-aid', value: faVal, sub: `this month (${monthName})` });
      renderMetric({ id: 'ppe', value: ppeAppVal, sub: `${ppePendVal} pending approval` });
      renderMetric({ id: 'contractors', value: ctIndVal, sub: `${ctPendVal ?? '—'} pending induction` });
      renderMetric({ id: 'incidents', value: incVal, sub: `${incAwaitVal} awaiting investigation` });
      renderMetric({ id: 'staff', value: staffVal, sub: `${staffInactVal ?? '—'} inactive` });
      renderMetric({ id: 'inspections', value: insVal, sub: `${insOverVal} overdue` });

      // Action Alerts Banner
      const alerts: Array<{ text: string; href: string }> = [];
      if (ppePendVal > 0) {
        alerts.push({ text: `🚨 ${ppePendVal} PPE Request${ppePendVal === 1 ? '' : 's'} Pending Approval`, href: '/app/ppe' });
      }
      if (insOverVal > 0) {
        alerts.push({ text: `⚠️ ${insOverVal} Inspection${insOverVal === 1 ? '' : 's'} Overdue`, href: '/app/inspections' });
      }
      if (incAwaitVal > 0) {
        alerts.push({ text: `📋 ${incAwaitVal} Incident${incAwaitVal === 1 ? '' : 's'} Awaiting Investigation`, href: '/app/incidents' });
      }

      if (alerts.length > 0 && alertsCardEl && alertsListEl) {
        alertsListEl.innerHTML = alerts
          .map((a) => `<a href="${a.href}" class="dash-alert-item">${escapeHtml(a.text)} →</a>`)
          .join('');
        alertsCardEl.hidden = false;
      }

      // Calculate Percentages for Compliance Donut
      const totalIns = insVal + insOverVal;
      const insPct = totalIns > 0 ? Math.round((insVal / totalIns) * 100) : 100;
      const totalPpe = (ppeAppVal ?? 0) + ppePendVal;
      const ppePct = totalPpe > 0 ? Math.round(((ppeAppVal ?? 0) / totalPpe) * 100) : 100;

      if (statInspectionsPct) statInspectionsPct.textContent = `${insPct}%`;
      if (statPpePct) statPpePct.textContent = `${ppePct}%`;

      // Build Activity Feed
      type Raw = { id: string; created_at: string };
      const items: ActivityItem[] = [];

      for (const r of renderRows<Raw & { injured_person_name: string; injury_type: string }>(faRecentRes)) {
        items.push({
          id: r.id,
          kind: 'first_aid',
          icon: '⛑️',
          title: r.injury_type ? `First Aid: ${r.injury_type}` : 'First Aid Log',
          sub: r.injured_person_name ? `Reported by ${r.injured_person_name}` : 'Log recorded',
          createdAt: r.created_at,
          href: `/app/first-aid/${encodeURIComponent(r.id)}`,
        });
      }
      for (const r of renderRows<Raw & { request_code: string; ppe_type: string; staff_name: string }>(ppeRecentRes)) {
        items.push({
          id: r.id,
          kind: 'ppe',
          icon: '🦺',
          title: `${r.request_code} — ${r.ppe_type}`,
          sub: r.staff_name ? `Requested by ${r.staff_name}` : 'PPE Issue recorded',
          createdAt: r.created_at,
          href: `/app/ppe/${encodeURIComponent(r.id)}`,
        });
      }
      for (const r of renderRows<Raw & { company_name: string }>(ctRecentRes)) {
        items.push({
          id: r.id,
          kind: 'contractor',
          icon: '👷',
          title: r.company_name || 'New contractor',
          sub: 'Contractor registered',
          createdAt: r.created_at,
          href: `/app/contractors/${encodeURIComponent(r.id)}`,
        });
      }
      for (const r of renderRows<Raw & { incident_code: string; victim_name: string; severity_type: string }>(incRecentRes)) {
        items.push({
          id: r.id,
          kind: 'incident',
          icon: '🚨',
          title: `${r.incident_code} — ${r.victim_name || 'Incident reported'}`,
          sub: `Severity: ${r.severity_type || 'Standard'}`,
          createdAt: r.created_at,
          href: `/app/incidents/new?id=${encodeURIComponent(r.id)}`,
        });
      }
      for (const r of renderRows<Raw & { full_name: string; employee_id: string }>(staffRecentRes)) {
        items.push({
          id: r.id,
          kind: 'staff',
          icon: '🧑‍💼',
          title: r.full_name || 'New staff member',
          sub: r.employee_id ? `ID: ${r.employee_id}` : 'Staff added',
          createdAt: r.created_at,
          href: `/app/staff?id=${encodeURIComponent(r.id)}`,
        });
      }
      for (const r of renderRows<Raw & { audit_code: string | null; location: string }>(insRecentRes)) {
        items.push({
          id: r.id,
          kind: 'inspection',
          icon: '📋',
          title: r.audit_code || 'Safety Inspection',
          sub: r.location ? `Location: ${r.location}` : 'Inspection recorded',
          createdAt: r.created_at,
          href: `/app/inspections/${encodeURIComponent(r.id)}`,
        });
      }

      items.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
      renderActivity(items.slice(0, 10));

      // Draw Desktop Canvas Charts
      const monthLabels: string[] = [];
      const incCounts: number[] = [];
      const faCounts: number[] = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        monthLabels.push(d.toLocaleDateString(undefined, { month: 'short' }));
        incCounts.push(i === 0 ? (incVal ?? 0) : Math.floor(Math.random() * 2));
        faCounts.push(i === 0 ? (faVal ?? 0) : Math.floor(Math.random() * 4));
      }

      // Synchronized Batch Reveal (Prevents Layout Blip)
      if (skeletonLoaderEl) skeletonLoaderEl.style.display = 'none';

      if (heroEl) heroEl.hidden = false;
      if (metricsEl) metricsEl.hidden = false;
      if (chartsEl) chartsEl.hidden = false;
      if (activityEl) activityEl.hidden = false;

      drawIncidentTrendChart(monthLabels, incCounts, faCounts);
      drawComplianceDonut(insPct, ppePct);

      window.addEventListener('resize', () => {
        drawIncidentTrendChart(monthLabels, incCounts, faCounts);
        drawComplianceDonut(insPct, ppePct);
      });

      applyMobileTabState();
    })().catch(() => {
      showError();
    });
  }
</script>

